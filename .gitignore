# --- Secret-shaped files ---------------------------------------------------
# Defense-in-depth: never let key material or credentials enter this repo.
# (This public repo was published with a fresh history precisely so that no
# historical secret from the development repo could travel with it.)
# scripts/build_submission.sh already fails the build on these patterns.
*.pem
*.key
*_key
*credentials*
.env.*
!.env.example

# Claude Code session state, never part of the repository
.claude/
