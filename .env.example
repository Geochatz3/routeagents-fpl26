# Copy to .env and fill in. Format: KEY=value, no spaces around '=',
# no quotes. Loaded automatically by every `make` target; `python3
# dcp_optimizer.py` invoked directly does NOT read this file — export the
# variables or use --api-key instead. Never commit .env.

# REQUIRED for the full LLM-guided modes (run_optimizer,
# run_once). Not needed for the LLM-free mode (run_no_llm),
# validation, or the offline test suite.
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# OPTIONAL — common overrides (full reference: docs/CONFIGURATION.md)
# Vivado executable if not on PATH (WSL2: the Windows vivado.bat path)
#VIVADO_EXEC=/tools/Xilinx/Vivado/2025.1/bin/vivado
# Alternative OpenAI-compatible endpoint (default: https://openrouter.ai/api/v1)
#OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Where run directories are created (default: alongside the repo)
#FPL26_RUN_DIR_BASE=/path/with/space
